{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-ml-kiosk/test-oic-stock-api/artifacts/json-schema/alert-evaluation-request.schema.json",
  "title": "OIC Stock Alert Evaluation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol",
    "rules"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "maxLength": 80
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "examples": [
            "OIC"
          ]
        },
        "integrationName": {
          "type": "string",
          "maxLength": 120
        },
        "instanceId": {
          "type": "string"
        }
      }
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9.:-]{0,14}$",
      "examples": [
        "ORCL"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Za-z]{3}$",
      "examples": [
        "USD"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/alertRule"
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerMode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "includeDiagnostics": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "alertRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "metric",
        "operator",
        "threshold"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "metric": {
          "type": "string",
          "enum": [
            "lastPrice",
            "changePercent",
            "dayHigh",
            "dayLow",
            "volume"
          ]
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "absGte"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "high",
            "critical"
          ],
          "default": "warning"
        },
        "message": {
          "type": "string",
          "maxLength": 240
        }
      }
    }
  }
}
